{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": ["error", { "ignoreRestSiblings": true }],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["dist"]
}
