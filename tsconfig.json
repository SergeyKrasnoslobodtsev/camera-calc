{
  "compilerOptions": {
    "noEmit": true,
    "target": "esnext",
    "module": "nodenext",
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": ["vite.config.ts", "src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
}
